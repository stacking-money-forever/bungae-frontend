# Server-only bare HTTP(S) origin. Do not add /api/v1 or credentials.
BUNGAE_API_ORIGIN=http://127.0.0.1:8080

# Public Firebase web identifiers. Push remains unavailable unless apiKey,
# projectId, messagingSenderId, appId, and the VAPID key are configured.
NEXT_PUBLIC_FCM_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
